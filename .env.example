# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit real secrets.

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# DATABASE
# Toggle the active pair. Comment out the one you are not using.
#
# DATABASE_URL → runtime queries (pooler in production)
# DIRECT_URL   → migrations only (direct connection, bypasses pooler)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# ── LOCAL (Docker) ──────────────────────────────────────────────
DATABASE_URL=postgresql://rabbit_user:rabbit_pass@localhost:5432/rabbit_nursery?sslmode=disable
DIRECT_URL=postgresql://rabbit_user:rabbit_pass@localhost:5432/rabbit_nursery?sslmode=disable

# ── SUPABASE (production) ───────────────────────────────────────
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10&sslmode=require
# DIRECT_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# AUTH
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# SENSOR / ARDUINO
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
SENSOR_API_KEY=replace-with-a-random-key
IS_CONTROLLER_CONNECTED=false
SENSOR_PORT=/dev/ttyUSB0
SENSOR_BAUD_RATE=9600
SENSOR_ID=DHT11_01
SENSOR_SAVE_INTERVAL_MS=300000
SENSOR_WEIGHT_THRESHOLD_GRAMS=100
SENSOR_CONDITIONAL_SAVE_INTERVAL_MS=10000
SENSOR_MOTION_ZERO_TOLERANCE_COUNT=3

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# THRESHOLDS
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
TEMPERATURE_THRESHOLD_DOWN=23
TEMPERATURE_THRESHOLD_UP=28

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# MAIL
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
MAILTRAP_TOKEN=
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_USER=
MAILTRAP_PASS=

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# SERVER
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
PORT=4000
